{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "wt", "cmd": "wt", "args": true },
        { "name": "memory", "cmd": "memory", "args": true }
      ]
    }
  ]
}
