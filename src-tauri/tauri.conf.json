{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Studio",
  "version": "0.1.0",
  "identifier": "com.stillmvd.echo-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Echo Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "stillmvd",
    "copyright": "Copyright (c) 2026 stillmvd",
    "shortDescription": "Visual manager for EchoVault memories and AI agent session logs",
    "longDescription": "Echo Studio is a portable Windows desktop app that lets you browse, search, edit, archive, and delete EchoVault memories, and explore session logs from your AI coding agent CLI in a chat-style viewer.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
